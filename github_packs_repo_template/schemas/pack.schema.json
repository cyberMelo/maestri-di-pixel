{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestridipixel.local/schemas/pack.schema.json",
  "title": "MaestriDiPixelPackV1",
  "description": "Schema ufficiale per i pacchetti didattici JSON di Maestri di Pixel (schema_version = 1), allineato a PackValidator.kt e MathGenerator.kt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "subject",
    "grade",
    "title",
    "version",
    "boss_name",
    "boss_title",
    "medal_name",
    "medal_icon"
  ],
  "anyOf": [
    {
      "required": ["questions"],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 5
        }
      }
    },
    {
      "required": ["generators"],
      "properties": {
        "generators": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,48}$",
      "description": "Identificativo univoco snake_case (3-48 caratteri), es. storia_egizi."
    },
    "subject": {
      "type": "string",
      "enum": ["storia", "geografia", "scienze", "matematica", "italiano", "inglese"]
    },
    "grade": {
      "type": "integer",
      "enum": [4, 5],
      "description": "Classe della scuola primaria (4a o 5a)."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Incrementare di 1 ad ogni aggiornamento del pacchetto per il sync GitHub."
    },
    "boss_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "boss_title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "medal_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "medal_icon": {
      "type": "string",
      "pattern": "^medal_[a-z0-9_]{2,26}$",
      "examples": [
        "medal_egypt",
        "medal_history",
        "medal_geo",
        "medal_leaf",
        "medal_math",
        "medal_book",
        "medal_english",
        "medal_default"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/multipleChoiceQuestion" },
          { "$ref": "#/$defs/trueFalseQuestion" },
          { "$ref": "#/$defs/numericInputQuestion" }
        ]
      }
    },
    "generators": {
      "type": "array",
      "description": "Generatori parametrici di matematica (opzionali).",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/multiplicationTableGenerator" },
          { "$ref": "#/$defs/mentalAddSubGenerator" },
          { "$ref": "#/$defs/unitConversionGenerator" }
        ]
      }
    }
  },
  "$defs": {
    "questionId": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,64}$"
    },
    "topicLabel": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "description": "Argomento didattico breve per il filtro in Area Genitori (es. 'Il Nilo e il territorio', 'Frazioni')."
    },
    "difficultyLevel": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "promptText": {
      "type": "string",
      "minLength": 5,
      "maxLength": 140,
      "description": "Testo domanda (max 140 caratteri; può usare **parole chiave** in grassetto)."
    },
    "hintText": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90,
      "description": "Indizio breve non rivelatore (max 90 caratteri)."
    },
    "explanationText": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160,
      "description": "Spiegazione chiara mostrata dopo la risposta (max 160 caratteri)."
    },
    "multipleChoiceQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "difficulty", "prompt", "hint", "options", "correct_index", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "topic": { "$ref": "#/$defs/topicLabel" },
        "type": { "const": "multiple_choice" },
        "difficulty": { "$ref": "#/$defs/difficultyLevel" },
        "prompt": { "$ref": "#/$defs/promptText" },
        "hint": { "$ref": "#/$defs/hintText" },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45
          }
        },
        "correct_index": {
          "type": "integer",
          "enum": [0, 1, 2, 3]
        },
        "explanation": { "$ref": "#/$defs/explanationText" }
      }
    },
    "trueFalseQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "difficulty", "prompt", "hint", "correct_bool", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "topic": { "$ref": "#/$defs/topicLabel" },
        "type": { "const": "true_false" },
        "difficulty": { "$ref": "#/$defs/difficultyLevel" },
        "prompt": { "$ref": "#/$defs/promptText" },
        "hint": { "$ref": "#/$defs/hintText" },
        "correct_bool": { "type": "boolean" },
        "explanation": { "$ref": "#/$defs/explanationText" }
      }
    },
    "numericInputQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "difficulty", "prompt", "hint", "correct_value", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "topic": { "$ref": "#/$defs/topicLabel" },
        "type": { "const": "numeric_input" },
        "difficulty": { "$ref": "#/$defs/difficultyLevel" },
        "prompt": { "$ref": "#/$defs/promptText" },
        "hint": { "$ref": "#/$defs/hintText" },
        "correct_value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "maxLength": 12
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "explanation": { "$ref": "#/$defs/explanationText" }
      }
    },
    "multiplicationTableGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "template", "difficulty", "params", "pool_size"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "topic": { "$ref": "#/$defs/topicLabel" },
        "template": { "const": "multiplication_table" },
        "difficulty": { "$ref": "#/$defs/difficultyLevel" },
        "pool_size": { "type": "integer", "minimum": 4, "maximum": 30 },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_a": { "type": "integer", "minimum": 1, "maximum": 20 },
            "max_a": { "type": "integer", "minimum": 1, "maximum": 20 },
            "min_b": { "type": "integer", "minimum": 1, "maximum": 20 },
            "max_b": { "type": "integer", "minimum": 1, "maximum": 20 }
          }
        }
      }
    },
    "mentalAddSubGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "template", "difficulty", "params", "pool_size"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "topic": { "$ref": "#/$defs/topicLabel" },
        "template": { "const": "mental_add_sub" },
        "difficulty": { "$ref": "#/$defs/difficultyLevel" },
        "pool_size": { "type": "integer", "minimum": 4, "maximum": 30 },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_val": { "type": "integer", "minimum": 1, "maximum": 999 },
            "max_val": { "type": "integer", "minimum": 6, "maximum": 1000 },
            "allow_sub": { "type": "boolean" }
          }
        }
      }
    },
    "unitConversionGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "template", "difficulty", "params", "pool_size"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "topic": { "$ref": "#/$defs/topicLabel" },
        "template": { "const": "unit_conversion" },
        "difficulty": { "$ref": "#/$defs/difficultyLevel" },
        "pool_size": { "type": "integer", "minimum": 4, "maximum": 30 },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family"],
          "properties": {
            "family": {
              "type": "string",
              "enum": ["length", "mass", "capacity"]
            }
          }
        }
      }
    }
  }
}
